                  "pm.environment.set(\"mockToken\", data.data.token);",
                  "pm.environment.unset(\"orderId\");"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "04 新增订单并提取 ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mockToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "http://127.0.0.1:18080/mock-order/v1/orders",
            "description": "本地有状态 Mock。测试账号 demo / demo12345；业务数据仅供测试。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"自动化测试订单\",\n  \"amount\": 19900,\n  \"quantity\": 2,\n  \"status\": \"draft\",\n  \"remark\": \"仅用于 Mock 验证\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "pm.test(\"统一响应结构\", function () { pm.expect(data).to.have.keys(\"status\", \"code\", \"errmsg\", \"data\", \"timestamp\"); });",
                  "pm.environment.set(\"orderId\", data.data.id);",
                  "pm.test(\"订单创建成功\", function () { pm.expect(data.data.title).to.eql(\"自动化测试订单\"); });"
                ]
              }
            }
          ],
          "response": []
        },
