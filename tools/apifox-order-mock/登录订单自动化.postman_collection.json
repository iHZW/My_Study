              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"demo12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"统一响应结构\", function () { pm.expect(data).to.have.keys(\"status\", \"code\", \"errmsg\", \"data\", \"timestamp\"); });",
