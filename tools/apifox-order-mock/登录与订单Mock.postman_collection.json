  "item": [
    {
      "name": "登录与订单 Mock",
      "item": [
        {
          "name": "01 登录并提取 token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "http://127.0.0.1:18080/mock-order/v1/auth/login",
            "description": "本地有状态 Mock。测试账号 demo / demo12345；业务数据仅供测试。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"demo12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"统一响应结构\", function () { pm.expect(data).to.have.keys(\"status\", \"code\", \"errmsg\", \"data\", \"timestamp\"); });",
                  "pm.test(\"登录返回 token\", function () { pm.expect(data.data.token).to.be.a(\"string\").and.not.empty; });",
                  "pm.environment.set(\"mockToken\", data.data.token);",
                  "pm.environment.unset(\"orderId\");"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "成功",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "url": "http://127.0.0.1:18080/mock-order/v1/auth/login",
                "description": "本地有状态 Mock。测试账号 demo / demo12345；业务数据仅供测试。",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"demo12345\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"1\",\n  \"code\": 0,\n  \"errmsg\": \"\",\n  \"data\": {\n    \"token\": \"mock-example-token\",\n    \"tokenType\": \"Bearer\",\n    \"expiresIn\": 3600,\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"演示用户\"\n    }\n  },\n  \"timestamp\": 0\n}"
            }
          ]
        },
